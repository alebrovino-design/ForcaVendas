<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/dashboard_background_light"
    android:fillViewport="true"
    tools:context=".SecondFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/dashboard_header"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="20dp"
            android:paddingEnd="20dp"
            android:paddingBottom="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="140dp"
                    android:layout_height="48dp"
                    app:cardBackgroundColor="@color/white"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="0dp">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="Special Nutri"
                        android:padding="10dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/specialnutri_logo" />
                </com.google.android.material.card.MaterialCardView>

                <Space
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/menu_theme_button"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:contentDescription="Alternar aparência do aplicativo"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:minWidth="0dp"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:text="Escuro"
                    android:textAllCaps="false"
                    android:textColor="@color/white"
                    app:backgroundTint="#405CAB"
                    app:cornerRadius="12dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/menu_exit_button"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="8dp"
                    android:contentDescription="Encerrar sessão"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:minWidth="0dp"
                    android:padding="0dp"
                    android:text="×"
                    android:textColor="@color/white"
                    android:textSize="24sp"
                    app:backgroundTint="#405CAB"
                    app:cornerRadius="12dp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/menu_avatar_card"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:clickable="true"
                    android:contentDescription="Escolher foto do avatar"
                    android:focusable="true"
                    app:cardBackgroundColor="@color/white"
                    app:cardCornerRadius="28dp"
                    app:cardElevation="0dp">

                    <ImageView
                        android:id="@+id/menu_avatar_photo"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="Foto do usuário"
                        android:scaleType="centerCrop"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/menu_avatar_initials"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:textColor="#1B327E"
                        android:textSize="20sp"
                        android:textStyle="bold" />
                </com.google.android.material.card.MaterialCardView>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="FORÇA DE VENDAS"
                        android:textColor="#D0DBFF"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/menu_user_name"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textColor="@color/white"
                        android:textSize="21sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/menu_user_details"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:textColor="#D0DBFF"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="18dp"
            android:paddingTop="20dp"
            android:paddingEnd="18dp"
            android:paddingBottom="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:tag="dashboard_primary"
                android:text="Visão geral"
                android:textColor="@color/dashboard_text_light"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:tag="dashboard_secondary"
                android:text="Acompanhe seus resultados do mês"
                android:textColor="@color/dashboard_secondary_light"
                android:textSize="13sp" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:tag="dashboard_surface"
                app:cardBackgroundColor="@color/dashboard_surface_light"
                app:cardCornerRadius="20dp"
                app:cardElevation="1dp"
                app:strokeColor="@color/dashboard_stroke_light"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:tag="dashboard_primary"
                        android:text="@string/target_title"
                        android:textColor="@color/dashboard_text_light"
                        android:textSize="17sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:tag="dashboard_secondary"
                            android:text="@string/target_label"
                            android:textColor="@color/dashboard_secondary_light" />

                        <TextView
                            android:id="@+id/target_value"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:tag="dashboard_primary"
                            android:text="Consultando..."
                            android:textColor="@color/dashboard_text_light"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <ProgressBar
                        android:id="@+id/target_progress"
                        style="@android:style/Widget.ProgressBar.Horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="12dp"
                        android:layout_marginTop="8dp"
                        android:max="100"
                        android:progress="100"
                        android:progressTint="@color/target_gray" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:tag="dashboard_secondary"
                            android:text="@string/achieved_label"
                            android:textColor="@color/dashboard_secondary_light" />

                        <TextView
                            android:id="@+id/achieved_value"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:tag="dashboard_accent"
                            android:textColor="@color/dashboard_accent_light"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <ProgressBar
                        android:id="@+id/achieved_progress"
                        style="@android:style/Widget.ProgressBar.Horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="12dp"
                        android:layout_marginTop="8dp"
                        android:max="100"
                        android:progressTint="@color/achieved_blue" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:tag="dashboard_secondary"
                            android:text="Projeção da meta"
                            android:textColor="@color/dashboard_secondary_light" />

                        <TextView
                            android:id="@+id/projection_value"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:tag="dashboard_accent"
                            android:textColor="@color/dashboard_accent_light"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <ProgressBar
                        android:id="@+id/projection_progress"
                        style="@android:style/Widget.ProgressBar.Horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="12dp"
                        android:layout_marginTop="8dp"
                        android:max="100"
                        android:progressTint="#FF9800" />

                    <TextView
                        android:id="@+id/projection_status"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:tag="dashboard_secondary"
                        android:textColor="@color/dashboard_secondary_light"
                        android:textSize="13sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="8dp"
                android:tag="dashboard_primary"
                android:text="Acesso rápido"
                android:textColor="@color/dashboard_text_light"
                android:textSize="18sp"
                android:textStyle="bold" />

            <GridLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="2">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/menu_orders"
                    style="@style/DashboardMenuCard">
                    <LinearLayout style="@style/DashboardMenuContent">
                        <ImageView style="@style/DashboardMenuIcon" android:src="@android:drawable/ic_menu_edit" />
                        <TextView style="@style/DashboardMenuLabel" android:text="@string/menu_orders" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/menu_products"
                    style="@style/DashboardMenuCard">
                    <LinearLayout style="@style/DashboardMenuContent">
                        <ImageView style="@style/DashboardMenuIcon" android:src="@android:drawable/ic_menu_search" />
                        <TextView style="@style/DashboardMenuLabel" android:text="@string/menu_products" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/menu_clients"
                    style="@style/DashboardMenuCard">
                    <LinearLayout style="@style/DashboardMenuContent">
                        <ImageView style="@style/DashboardMenuIcon" android:src="@android:drawable/ic_menu_myplaces" />
                        <TextView style="@style/DashboardMenuLabel" android:text="@string/menu_clients" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/menu_loads"
                    style="@style/DashboardMenuCard">
                    <LinearLayout style="@style/DashboardMenuContent">
                        <ImageView style="@style/DashboardMenuIcon" android:src="@android:drawable/ic_menu_share" />
                        <TextView style="@style/DashboardMenuLabel" android:text="@string/menu_loads" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/menu_sync"
                    style="@style/DashboardMenuCard">
                    <LinearLayout style="@style/DashboardMenuContent">
                        <ImageView style="@style/DashboardMenuIcon" android:src="@android:drawable/ic_popup_sync" />
                        <TextView style="@style/DashboardMenuLabel" android:text="@string/menu_sync" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </GridLayout>

        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
