<resources>
    <style name="DashboardMenuCard" parent="Widget.Material3.CardView.Elevated">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">120dp</item>
        <item name="android:layout_columnWeight">1</item>
        <item name="android:layout_margin">5dp</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:tag">dashboard_surface</item>
        <item name="cardBackgroundColor">@color/dashboard_surface_light</item>
        <item name="cardCornerRadius">18dp</item>
        <item name="cardElevation">1dp</item>
        <item name="strokeColor">@color/dashboard_stroke_light</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <style name="DashboardMenuContent">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:padding">16dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:orientation">vertical</item>
    </style>

    <style name="DashboardMenuIcon">
        <item name="android:layout_width">32dp</item>
        <item name="android:layout_height">32dp</item>
        <item name="android:tag">dashboard_accent</item>
        <item name="android:tint">@color/dashboard_accent_light</item>
        <item name="android:importantForAccessibility">no</item>
    </style>

    <style name="DashboardMenuLabel">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">12dp</item>
        <item name="android:tag">dashboard_primary</item>
        <item name="android:textColor">@color/dashboard_text_light</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
    </style>
</resources>
